{
  "schemaVersion": 1,
  "id": "unique_relics",
  "version": "${version}",
  "name": "Unique Relics",
  "description": "Adds persistent collectible metadata and randomized trim colors to existing items.",
  "authors": [
    "Mortylovelly"
  ],
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mortylovelly.uniquerelics.UniqueRelics"
    ],
    "client": [
      "com.mortylovelly.uniquerelics.UniqueRelicsClient"
    ]
  },
  "mixins": [
    "unique_relics.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
